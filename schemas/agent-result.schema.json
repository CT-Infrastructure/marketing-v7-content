{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_key",
    "lease_token",
    "fence",
    "input_sha256",
    "base_revision",
    "status",
    "summary",
    "changed_paths",
    "tests",
    "artifacts",
    "blockers"
  ],
  "properties": {
    "task_key": {
      "type": "string"
    },
    "lease_token": {
      "type": "string"
    },
    "fence": {
      "type": "integer",
      "minimum": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_revision": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready_for_review",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code",
          "environment"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "environment": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actual_cost_usd": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
