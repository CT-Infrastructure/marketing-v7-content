flowchart TB
  IN["C66: Approved WordPress source and eligible list"]:::source
  CONTROL["Required controls<br/>X02, X03, X05, X06"]:::control
  S1["Create digest and subject options<br/><b>WordPress / bounded integration</b>"]:::process
  IN --> S1
  S2["editorial check<br/><b>Vale / Playwright / human QA</b>"]:::process
  S1 --> S2
  S3["pass to Mautic<br/><b>WordPress / bounded integration</b>"]:::process
  S2 --> S3
  S4["Validate facts, rights, format and exact<br/>revision<br/><b>Vale / validators / OpenProject</b>"]:::process
  S3 --> S4
  GATE{"Exact artifact, rights and intended<br/>handoff approved?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Hand off approved artifact; recipient<br/>rechecks release controls<br/><b>Native destination of new derivative</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Newsletter; V5 consent and dispatch policy"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>M17, X10"]:::ext
  OUT --> NEXT

