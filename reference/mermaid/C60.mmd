flowchart TB
  IN["C60: Approved selection criteria and product<br/>facts"]:::source
  CONTROL["Required controls<br/>X02, X03, X05, X06"]:::control
  S1["Build decision criteria and source-checked<br/>comparisons<br/><b>SearXNG / approved source APIs</b>"]:::process
  IN --> S1
  S2["typeset<br/><b>Pandoc / conditional Typst</b>"]:::process
  S1 --> S2
  S3["Validate facts, rights, format and exact<br/>revision<br/><b>Vale / validators / OpenProject</b>"]:::process
  S2 --> S3
  GATE{"Exact artifact, rights and intended<br/>handoff approved?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Hand off approved artifact; recipient<br/>rechecks release controls<br/><b>ResourceSpace approved document</b>"]:::process
  GATE -- "Yes" --> S4
  OUT["Buyer guide; avoid fabricated pricing"]:::done
  S4 --> OUT
  NEXT["Connected handoffs<br/>M01, M20"]:::ext
  OUT --> NEXT

